rules_version = '2';
// 기술사 6개월 회원 승인 규칙. Firebase 콘솔 → Firestore Database → 규칙에 그대로 붙여 넣고 게시한다.
// members/{uid}: 이 휴대폰(익명 계정 uid)의 아이디와 승인 상태(pending·approved·rejected)
// ids/{아이디}: 아이디 중복 방지(어느 휴대폰 것인지)
// codes/{초대 코드}: 이 코드로 만들면 바로 승인(관리자가 만들고 지운다)
// admins/{uid}: 관리자(콘솔에서 직접 만든다)
// msgs/{자동 ID}: 관리자에게 보낸 문자(3.0.1부터)
// replies/{자동 ID}: 관리자가 보낸 답장(3.1.3부터, 승인·거절과 함께 보낼 수 있다)
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(db)/documents/admins/$(request.auth.uid)); }
    function validId(id) { return id is string && id.size() >= 2 && id.size() <= 16 && id.matches('^[a-z0-9_가-힣]+$'); }

    match /members/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      // 본인 휴대폰에서 한 번만 만든다. 아이디 문서를 같은 요청에서 함께 만들어야 한다.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['id', 'status', 'createdAt', 'code'])
        && validId(request.resource.data.id)
        && request.resource.data.createdAt is timestamp
        && getAfter(/databases/$(db)/documents/ids/$(request.resource.data.id)).data.uid == uid
        && (request.resource.data.status == 'pending'
            || (request.resource.data.status == 'approved'
                && request.resource.data.code is string
                && exists(/databases/$(db)/documents/codes/$(request.resource.data.code))));
      // 승인 상태는 관리자만 바꾼다(아이디는 바꾸지 못한다)
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt'])
        && request.resource.data.status in ['pending', 'approved', 'rejected'];
      // 본인은 아이디 지우기, 관리자는 정리
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    match /ids/{id} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create: if signedIn() && validId(id)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(db)/documents/members/$(request.auth.uid)).data.id == id;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    match /codes/{code} {
      allow read, delete: if isAdmin();
      allow create: if isAdmin() && request.resource.data.keys().hasOnly(['createdAt']);
    }

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
    }

    // msgs/{자동 ID}: 관리자에게 보내는 문자(승인 요청 문구, 앱 안 문의). 아이디가 있는 휴대폰만 자기 아이디로 보낸다.
    // from: join(아이디 만들 때) · wait(승인 대기 화면) · app(앱 안), dev: "iOS 18.1 · 앱 3.0.1" 같은 기기 정보, at: 서버 시각
    match /msgs/{mid} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'id', 'text', 'from', 'dev', 'at', 'read'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.id == get(/databases/$(db)/documents/members/$(request.auth.uid)).data.id
        && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 500
        && request.resource.data.from in ['join', 'wait', 'app']
        && (!('dev' in request.resource.data) || (request.resource.data.dev is string && request.resource.data.dev.size() <= 60))
        && request.resource.data.at == request.time
        && request.resource.data.read == false;
      // 관리자는 모두, 본인은 자기 문자만(아이디 지우기 때 함께 지운다)
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      // 관리자는 읽음 표시만 바꾼다
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // replies/{자동 ID}: 관리자 답장. 관리자만 쓰고(받는 회원의 기기 번호·아이디, 500자, 서버 시각, 안 읽음으로),
    // 받는 회원은 자기 것만 읽고 읽음으로만 바꾸고 지운다(아이디 지우기 때 함께). dec: 함께 한 승인(approved)·거절(rejected)
    match /replies/{rid} {
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['uid', 'id', 'text', 'dec', 'at', 'read'])
        && request.resource.data.uid is string
        && request.resource.data.id == get(/databases/$(db)/documents/members/$(request.resource.data.uid)).data.id
        && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 500
        && (!('dec' in request.resource.data) || request.resource.data.dec in ['approved', 'rejected'])
        && request.resource.data.at == request.time
        && request.resource.data.read == false;
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }
  }
}
