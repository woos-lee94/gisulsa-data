rules_version = '2';
// 기술사 6개월 회원 승인 규칙. Firebase 콘솔 → Firestore Database → 규칙에 그대로 붙여 넣고 게시한다.
// members/{uid}: 이 휴대폰(익명 계정 uid)의 아이디와 승인 상태(pending·approved·rejected)
// ids/{아이디}: 아이디 중복 방지(어느 휴대폰 것인지)
// codes/{초대 코드}: 이 코드로 만들면 바로 승인(관리자가 만들고 지운다)
// admins/{uid}: 관리자(콘솔에서 직접 만든다)
// msgs/{자동 ID}: 관리자에게 보낸 문자(3.0.1부터)
// replies/{자동 ID}: 관리자가 보낸 답장(3.1.3부터, 승인·거절과 함께 보낼 수 있다)
// config/plan: 관리자 앱의 시험 일정(3.2.1부터). 예약 작업(세트·모의고사를 만드는 Claude)이 로그인 없이 읽고 같은 일정으로 맞춘다
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(db)/documents/admins/$(request.auth.uid)); }
    function validId(id) { return id is string && id.size() >= 2 && id.size() <= 16 && id.matches('^[a-z0-9_가-힣]+$'); }
    function isDate(s) { return s is string && s.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$'); }

    match /members/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      // 본인 휴대폰에서 한 번만 만든다. 아이디 문서를 같은 요청에서 함께 만들어야 한다.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['id', 'status', 'createdAt', 'code'])
        && validId(request.resource.data.id)
        && request.resource.data.createdAt is timestamp
        && getAfter(/databases/$(db)/documents/ids/$(request.resource.data.id)).data.uid == uid
        && (request.resource.data.status == 'pending'
            || (request.resource.data.status == 'approved'
                && request.resource.data.code is string
                && exists(/databases/$(db)/documents/codes/$(request.resource.data.code))));
      // 승인 상태는 관리자만 바꾼다(아이디는 바꾸지 못한다)
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt'])
        && request.resource.data.status in ['pending', 'approved', 'rejected'];
      // 본인은 아이디 지우기, 관리자는 정리
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    match /ids/{id} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create: if signedIn() && validId(id)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(db)/documents/members/$(request.auth.uid)).data.id == id;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    match /codes/{code} {
      allow read, delete: if isAdmin();
      allow create: if isAdmin() && request.resource.data.keys().hasOnly(['createdAt']);
    }

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
    }

    // msgs/{자동 ID}: 관리자에게 보내는 문자(승인 요청 문구, 앱 안 문의). 아이디가 있는 휴대폰만 자기 아이디로 보낸다.
    // from: join(아이디 만들 때) · wait(승인 대기 화면) · app(앱 안), dev: "iOS 18.1 · 앱 3.0.1" 같은 기기 정보, at: 서버 시각
    match /msgs/{mid} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'id', 'text', 'from', 'dev', 'at', 'read'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.id == get(/databases/$(db)/documents/members/$(request.auth.uid)).data.id
        && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 500
        && request.resource.data.from in ['join', 'wait', 'app']
        && (!('dev' in request.resource.data) || (request.resource.data.dev is string && request.resource.data.dev.size() <= 60))
        && request.resource.data.at == request.time
        && request.resource.data.read == false;
      // 관리자는 모두, 본인은 자기 문자만(아이디 지우기 때 함께 지운다)
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      // 관리자는 읽음 표시만 바꾼다
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // replies/{자동 ID}: 관리자 답장. 관리자만 쓰고(받는 회원의 기기 번호·아이디, 500자, 서버 시각, 안 읽음으로),
    // 받는 회원은 자기 것만 읽고 읽음으로만 바꾸고 지운다(아이디 지우기 때 함께). dec: 함께 한 승인(approved)·거절(rejected)
    match /replies/{rid} {
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['uid', 'id', 'text', 'dec', 'at', 'read'])
        && request.resource.data.uid is string
        && request.resource.data.id == get(/databases/$(db)/documents/members/$(request.resource.data.uid)).data.id
        && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 500
        && (!('dec' in request.resource.data) || request.resource.data.dec in ['approved', 'rejected'])
        && request.resource.data.at == request.time
        && request.resource.data.read == false;
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // config/plan: 관리자 앱이 시험 일정을 저장할 때 쓴다(관리자만, 칸과 형식이 정해진 문자열만, 서버 시각).
    // 공개 저장소의 data/index.json에도 같은 일정이 있으므로 누구나 읽어도 된다(예약 작업은 로그인 없이 읽는다).
    // start 예약 작업에 넣을 시작 주 월요일 · begin 앱의 준비 시작일 · target auto 또는 회차 · rounds "141=2027-01-30 142=…"(고친 회차 날짜)
    // tr·exam 그 일정의 목표 회차·시험 날(확인용) · next·nfrom·nexam 월요일부터 바꾸기로 한 목표(없으면 빈 칸)
    // terms 설정의 하루 외울 용어 수 = 세트 카드 수(3.2.6부터, "auto" 또는 "3"~"15", 없어도 된다: 그 전 앱은 보내지 않는다)
    // fresh 3.2.5 앱이 보내던 하루 새 용어 수("auto"·"1"~"10", 예약 작업은 읽지 않는다. 그 앱이 남아 있는 동안만 받는다)
    match /config/{doc} {
      allow get: if doc == 'plan';
      allow create, update: if doc == 'plan' && isAdmin()
        && request.resource.data.keys().hasOnly(['start', 'begin', 'target', 'rounds', 'tr', 'exam', 'next', 'nfrom', 'nexam', 'fresh', 'terms', 'at'])
        && request.resource.data.keys().hasAll(['start', 'begin', 'target', 'rounds', 'tr', 'exam', 'next', 'nfrom', 'nexam', 'at'])
        && isDate(request.resource.data.start) && isDate(request.resource.data.begin) && isDate(request.resource.data.exam)
        && request.resource.data.target is string && request.resource.data.target.matches('^(auto|[0-9]{3})$')
        && request.resource.data.tr is string && request.resource.data.tr.matches('^[0-9]{3}$')
        && request.resource.data.rounds is string && request.resource.data.rounds.size() <= 300
        && request.resource.data.rounds.matches('^([0-9]{3}=20[0-9]{2}-[01][0-9]-[0-3][0-9]( [0-9]{3}=20[0-9]{2}-[01][0-9]-[0-3][0-9])*)?$')
        && request.resource.data.next is string && request.resource.data.next.matches('^([0-9]{3})?$')
        && (request.resource.data.next == '' ? request.resource.data.nfrom == '' && request.resource.data.nexam == ''
            : isDate(request.resource.data.nfrom) && isDate(request.resource.data.nexam))
        && (!('fresh' in request.resource.data) || (request.resource.data.fresh is string && request.resource.data.fresh.matches('^(auto|[1-9]|10)$')))
        && (!('terms' in request.resource.data) || (request.resource.data.terms is string && request.resource.data.terms.matches('^(auto|[3-9]|1[0-5])$')))
        && request.resource.data.at == request.time;
    }
  }
}
