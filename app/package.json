{
  "name": "gisulsa-app",
  "version": "3.2.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "node scripts/build-web.js && expo start",
    "build:web": "node scripts/build-web.js",
    "ota": "node scripts/ota.js",
    "postinstall": "node scripts/build-web.js",
    "test": "node tests/app.test.js && node tests/plan.test.js && node tests/native.test.js && node tests/gloss.test.js",
